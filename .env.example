# Contract Intelligence + Integration Engine
# Configuration comes from environment variables only. Spec section 16.
# Never commit a filled copy of this file.

# PostgreSQL 16. A local container, or Azure Database for PostgreSQL Flexible Server.
# The application does not care which. Only this string changes.
DATABASE_URL=postgresql://postgres@localhost:5432/cie

# Set to "require" against Azure. Leave empty for a local container.
PGSSLMODE=

# Directory that holds the three seed CSV files.
CIE_SEED_DIR=./data/seed

# Directory that holds the scheduled source file drops. Spec decision D8.
# Ad hoc manual upload is not permitted.
CIE_DROP_DIR=./data/drops

# Application port.
PORT=3000

# SAM.gov Get Opportunities v2. A key from api.data.gov, registered for the
# Opportunities API. Never committed: this file is .env.example and .env is gitignored.
SAM_API_KEY=

# Override only to point the SAM.gov loader at a stub. Leave empty for the real API.
SAM_API_BASE=

# GovCon API. One key covering opportunities, awards, SAM entities and exclusions, sent as a
# bearer token. This is the primary opportunities feed: its delta endpoint answers "what changed
# since", which api.sam.gov cannot, and its quota is hourly rather than daily — which is what
# makes an hourly sync affordable. Never committed.
GOVCON_API_KEY=

# Override only to point the GovCon loader at a stub. Leave empty for the real API.
GOVCON_API_BASE=

# How the interface learns who is acting. entra reads the principal Azure Container Apps
# injects after it has authenticated the request; dev trusts CIE_DEV_USER and refuses to run
# with NODE_ENV=production; unset means no identity and every write is refused, which is the
# secure default. docs/DEPLOY.md has the Entra commands.
CIE_AUTH_MODE=
CIE_DEV_USER=
