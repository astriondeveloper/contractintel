{
  "name": "cie",
  "version": "0.1.0",
  "private": true,
  "description": "Contract Intelligence + Integration Engine. Build Specification v1.0, Phase 1.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "seed": "tsx src/loaders/run-seeds.ts",
    "load": "tsx src/loaders/run-load.ts",
    "load:fpds": "tsx src/loaders/run-fpds.ts",
    "load:subs": "tsx src/loaders/run-subcontract.ts",
    "accept": "tsx scripts/acceptance.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web": "tsx src/web/server.ts",
    "web:dev": "tsx watch src/web/server.ts"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
